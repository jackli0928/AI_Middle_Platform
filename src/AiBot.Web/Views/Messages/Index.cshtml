@model PageResult<MessageLog>
@{ ViewData["Title"] = "消息记录"; }
<div class="page-heading"><div><div class="eyebrow">MESSAGE ACTIVITY</div><h1>消息记录<span class="heading-dot">.</span></h1><p>每一次发送都有记录，每一个结果都清晰可查。</p></div><a class="button primary" asp-controller="Robots" asp-action="Send"><svg><use href="#i-send"/></svg>发送新消息</a></div>
<section class="panel"><div class="collection-toolbar inset"><div class="collection-title">发送记录<span class="count-pill">@Model.Total</span></div><form method="get" class="search-form"><svg><use href="#i-search"/></svg><input name="search" value="@ViewBag.Search" placeholder="搜索机器人、账号或群 Chat ID" aria-label="搜索消息记录" maxlength="256"/><button type="submit">搜索</button>@if (!string.IsNullOrEmpty(ViewBag.Search as string)) { <a asp-action="Index">清除</a> }</form></div><partial name="_MessageTable" model="Model.Items"/><div class="pagination"><span>共 @Model.Total 条 · 第 @Model.Page / @Model.Pages 页</span><div>@if (Model.Page > 1) { <a class="button secondary compact" asp-route-page="@(Model.Page - 1)" asp-route-search="@ViewBag.Search">上一页</a> }@if (Model.Page < Model.Pages) { <a class="button secondary compact" asp-route-page="@(Model.Page + 1)" asp-route-search="@ViewBag.Search">下一页</a> }</div></div></section><div class="inline-note"><svg><use href="#i-info"/></svg>“企微已接受”表示服务端回执成功，不表示接收人已读。点击消息内容可弹窗查看完整消息与回执详情。</div>
