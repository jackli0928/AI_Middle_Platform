@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status"><svg><use href="#i-check"/></svg><span>@success</span></div> }
@if (TempData["Error"] is string error) { <div class="alert alert-error" role="alert"><svg><use href="#i-info"/></svg><span>@error</span></div> }
