@model IReadOnlyList<KnowledgeEntry>
@{ ViewData["Title"] = "知识库问答"; var robots = ViewBag.Robots as IReadOnlyList<RobotInfo> ?? []; }
<div class="page-heading"><div><div class="eyebrow">KNOWLEDGE BASE</div><h1>知识库问答<span class="heading-dot">.</span></h1><p>维护标准问答，让机器人按规则给出准确回复。</p></div><a class="button primary" asp-action="Edit"><svg><use href="#i-plus"/></svg>新增知识</a></div>
<section class="panel"><div class="collection-toolbar inset"><div class="collection-title">问答条目<span class="count-pill">@Model.Count</span></div><form class="search-form" method="get"><svg><use href="#i-search"/></svg><input name="search" value="@ViewBag.Search" placeholder="搜索问题、匹配词或答案" aria-label="搜索知识库" maxlength="200"/><button type="submit">搜索</button></form></div>
@if (Model.Count == 0) { <div class="empty-state large"><div class="empty-art"><svg><use href="#i-list"/></svg></div><h2>建立你的第一条标准问答</h2><p>支持完整匹配或包含匹配，可为全部机器人共享，也可指定机器人。</p><a class="button primary" asp-action="Edit">新增知识条目</a></div> } else {
<div class="table-scroll"><table><thead><tr><th>问题 / 匹配词</th><th>适用范围</th><th>匹配规则</th><th>优先级</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach (var entry in Model) { <tr><td class="knowledge-question"><strong>@entry.Question</strong><small>@entry.Keywords</small></td><td>@(entry.RobotId is { } id ? robots.FirstOrDefault(x => x.Id == id)?.Name ?? "已删除的机器人" : "全部机器人")</td><td>@(entry.MatchMode == "exact" ? "完整匹配" : "包含匹配")</td><td class="mono">@entry.Priority</td><td><span class="badge @(entry.Enabled ? "success" : "neutral")">@(entry.Enabled ? "已启用" : "已停用")</span></td><td><div class="table-actions"><a class="text-link" asp-action="Edit" asp-route-id="@entry.Id">编辑</a><form asp-action="Delete" method="post" data-delete-name="@entry.Question" data-delete-kind="知识条目" data-delete-note="删除后不再参与匹配，已有回复记录仍会保留。"><input name="id" value="@entry.Id" type="hidden"/><button class="icon-button delete-button" title="删除知识" aria-label="删除 @entry.Question"><svg><use href="#i-trash"/></svg></button></form></div></td></tr> }</tbody></table></div> }
</section><div class="inline-note"><svg><use href="#i-info"/></svg>数字越小越先匹配；同优先级先匹配机器人专属条目，再匹配更长的词。未匹配时不自动回复。</div>
