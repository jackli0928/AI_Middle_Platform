@model KnowledgeInput
@{ ViewData["Title"] = Model.Id is null ? "新增知识" : "编辑知识"; var robots = ViewBag.Robots as IReadOnlyList<RobotInfo> ?? []; }
<div class="page-heading"><div><div class="eyebrow">KNOWLEDGE EDITOR</div><h1>@ViewData["Title"]<span class="heading-dot">.</span></h1><p>将高频问题整理成可复用的标准答案。</p></div><a class="button secondary" asp-action="Index">返回知识库</a></div>
<section class="panel settings-editor"><div class="panel-heading"><div><h2>问答与匹配规则</h2><p>答案支持 Markdown，最多 4096 个 UTF-8 字节</p></div></div><form asp-action="Edit" method="post" class="form-body" data-submit-lock><div asp-validation-summary="All" class="validation-summary" role="alert"></div><input asp-for="Id" type="hidden"/>
<div class="field"><label asp-for="Question">标准问题 *</label><input asp-for="Question" maxlength="300" required placeholder="例如：如何申请报销？"/></div>
<div class="field"><label asp-for="Keywords">其他匹配词 <span class="optional">选填</span></label><textarea asp-for="Keywords" maxlength="2000" rows="3" placeholder="每行一个匹配词或同义问题"></textarea><span class="field-help">标准问题也参与匹配；每行一个别名，不使用正则表达式。</span></div>
<div class="field"><label asp-for="Answer">标准答案 *</label><textarea asp-for="Answer" rows="8" maxlength="4096" required placeholder="填写机器人将直接回复的答案"></textarea></div>
<div class="settings-two-columns"><div class="field"><label asp-for="MatchMode">匹配方式</label><select asp-for="MatchMode"><option value="exact">完整匹配：整条消息等于问题或匹配词</option><option value="contains">包含匹配：消息中包含问题或匹配词</option></select></div><div class="field"><label asp-for="Priority">优先级</label><input asp-for="Priority" type="number" min="0" max="9999" required/><span class="field-help">数字越小越先匹配。</span></div></div>
<div class="field"><label asp-for="RobotId">适用机器人</label><select asp-for="RobotId"><option value="">全部机器人共享</option>@foreach (var robot in robots) { <option value="@robot.Id">@robot.Name</option> }</select></div>
<label class="switch-row"><span><strong>启用知识条目</strong><small>仅在机器人开启“知识库匹配回复”时参与匹配</small></span><span class="switch"><input asp-for="Enabled"/><span></span></span></label><div class="form-actions"><a class="button secondary" asp-action="Index">取消</a><button class="button primary" type="submit">保存知识</button></div></form></section>
