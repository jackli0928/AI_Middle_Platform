@model PasswordInput
@{ ViewData["Title"] = "账号安全"; }
<div class="page-heading"><div><div class="eyebrow">ACCOUNT SECURITY</div><h1>账号安全<span class="heading-dot">.</span></h1><p>定期更新密码，保护你的机器人工作空间。</p></div></div><section class="panel password-panel"><div class="panel-heading"><div><h2>修改登录密码</h2><p>更新后需要重新登录</p></div><span class="stat-icon mint"><svg><use href="#i-key"/></svg></span></div><form asp-action="Password" method="post" class="form-body" data-submit-lock><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="field"><label asp-for="CurrentPassword">当前密码</label><input asp-for="CurrentPassword" type="password" value="" required maxlength="128" autocomplete="current-password"/></div><div class="field"><label asp-for="NewPassword">新密码</label><input asp-for="NewPassword" type="password" value="" required minlength="12" maxlength="128" autocomplete="new-password"/><span class="field-help">使用 12–128 位密码，建议组合字母、数字与符号。</span></div><div class="field"><label asp-for="ConfirmPassword">确认新密码</label><input asp-for="ConfirmPassword" type="password" value="" required minlength="12" maxlength="128" autocomplete="new-password"/></div><div class="form-actions"><button class="button primary" type="submit">更新密码<svg><use href="#i-arrow"/></svg></button></div></form></section>
