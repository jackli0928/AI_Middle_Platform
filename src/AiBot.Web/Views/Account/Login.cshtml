@model LoginInput
@{ Layout = null; }
<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>登录 · Li 机器人中控</title><link rel="icon" href="~/favicon.svg" type="image/svg+xml"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/login.css" asp-append-version="true"/></head><body class="login-page"><partial name="_Icons"/><div class="login-shell"><section class="login-visual"><a class="brand" href="/"><span class="brand-mark"><svg><use href="#i-bot"/></svg></span><span>Li<span class="brand-dot">.</span> <b>机器人中控</b><small>AI BOT CONTROL CENTER</small></span></a><div class="login-pitch"><span class="banner-label"><span class="tiny-dot"></span> CONNECT. COLLABORATE. CREATE.</span><h1>让机器人，<br/>成为团队的<br/><span>连接力。</span></h1><p>一个工作台，连接企业微信与高效协作。<br/>配置机器人，传递消息，掌握每一次触达。</p><div class="login-feature"><span><svg><use href="#i-bot"/></svg>统一管理</span><span><svg><use href="#i-send"/></svg>精准发送</span><span><svg><use href="#i-shield"/></svg>安全可控</span></div></div><div class="login-orbit" aria-hidden="true"><div class="orbit"></div><div class="art-bot"><svg><use href="#i-bot"/></svg></div><span class="art-node"><svg><use href="#i-send"/></svg></span></div><span class="login-copyright">Li. AI Bot Control Center · 2026</span></section><section class="login-form-side"><div class="login-form-wrap"><span class="eyebrow">WELCOME BACK</span><h2>欢迎回来</h2><p class="login-subtitle">登录你的机器人工作空间</p><partial name="_Alerts"/>
@if (ViewBag.DatabaseReady != true) { <div class="alert alert-warning"><svg><use href="#i-info"/></svg><span>系统等待初始化。请完成本地数据库连接与管理员配置后登录。</span></div> }
<form asp-controller="Account" asp-action="Login" method="post" data-submit-lock><input asp-for="ReturnUrl" type="hidden"/><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="field"><label asp-for="Username">用户名</label><input asp-for="Username" placeholder="请输入管理员用户名" required maxlength="80" autocomplete="username" autofocus/></div><div class="field"><label asp-for="Password">密码</label><div class="password-input"><input asp-for="Password" type="password" value="" placeholder="请输入登录密码" required maxlength="128" autocomplete="current-password"/><button class="icon-button toggle-password" type="button" aria-label="显示密码"><svg><use href="#i-eye"/></svg></button></div></div><div class="login-session"><svg><use href="#i-shield"/></svg>受保护的管理入口，仅限授权账号访问</div><button class="button primary login-submit" type="submit">登录工作空间<svg><use href="#i-arrow"/></svg></button></form><div class="login-help">忘记密码？请联系系统管理员重置。</div></div><div class="login-bottom">统一管理 · 安全连接 · 高效协作</div></section></div><script src="~/js/site.js" asp-append-version="true" defer></script></body></html>
