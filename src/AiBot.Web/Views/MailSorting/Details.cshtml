@using AiBot.Application
@using AiBot.Web.Controllers
@model MailSortingDetails
@{
    ViewData["Title"] = "邮件分拣详情";
    var mail = Model.Mail;
    var category = mail.Review?.Category ?? mail.Analysis.Category;
}
<div class="page-heading">
    <div><h1>邮件分拣详情</h1><p>@(mail.Review?.Confirmed == true ? "已复核" : "待复核") · @mail.Analysis.Engine</p></div>
    <a class="button secondary" asp-action="Index">返回待办</a>
</div>
<div class="mail-details">
    <section class="panel mail-panel">
        <div class="panel-heading"><div><h2>@mail.Subject</h2><p>@mail.Sender · @mail.Source · @Display.Time(mail.ReceivedAt)</p></div></div>
        <div class="mail-body">
            <a class="button secondary" asp-action="Original" asp-route-id="@mail.Id">下载原始邮件</a>
            <h3>正文</h3>
            <pre class="mail-text">@mail.Analysis.Body</pre>
            <h3>附件</h3>
            @if (mail.Analysis.Attachments.Count == 0) { <p>无附件</p> }
            @for (var i = 0; i < mail.Analysis.Attachments.Count; i++)
            {
                var part = mail.Analysis.Attachments[i];
                <details class="mail-part">
                    <summary>@part.Name</summary>
                    <a asp-action="Attachment" asp-route-id="@mail.Id" asp-route-index="@i">下载原件</a>
                    @if (part.Note is not null) { <p>@part.Note</p> }
                    @if (part.Preview.Length > 0) { <pre class="mail-text">@part.Preview</pre> }
                </details>
            }
        </div>
    </section>
    <section class="panel mail-panel">
        <div class="panel-heading"><div><h2>分类与字段复核</h2><p>有多个候选值时，核对来源并填写确认值。留空时使用无冲突的识别结果。</p></div></div>
        <form class="mail-body" asp-action="Save" method="post">
            <input type="hidden" name="id" value="@mail.Id" />
            <input type="hidden" name="revision" value="@mail.Revision" />
            <div class="field"><label for="mail-review-category">业务分类</label>
                <select id="mail-review-category" name="category">
                    @foreach (var entry in MailSorting.Categories)
                    {
                        <option value="@entry.Key" selected="@(category == entry.Key)">@entry.Value</option>
                    }
                </select>
            </div>
            <div class="mail-fields">
                @{ var populated = mail.Analysis.Fields.Where(f => f.HasConflict || f.Candidates.Count > 0 || mail.Review?.Fields.ContainsKey(f.Key) == true); }
                @foreach (var field in populated)
                {
                    var candidates = field.Candidates.Select(c => c.Value).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
                    var edit = mail.Review?.Fields.GetValueOrDefault(field.Key);
                    <div class="field mail-field">
                        <label for="mail-field-@field.Key">@field.Label @if (field.HasConflict) { <span class="mail-conflict">字段冲突</span> }</label>
                        @if (field.Key == "service") { <p>@candidates.FirstOrDefault()</p> }
                        else
                        {
                            <input id="mail-field-@field.Key" name="fields[@field.Key]" maxlength="1500" value="@edit" placeholder="@(!field.HasConflict && candidates.Length == 1 ? candidates[0] : "")" />
                        }
                        @if (!string.IsNullOrWhiteSpace(field.ReviewEvidence))
                        { <details class="mail-evidence"><summary>查看原文冲突证据</summary><pre class="mail-text">@field.ReviewEvidence</pre></details> }
                        @if (field.Candidates.Count > 0)
                        {
                            <details class="mail-evidence"><summary>查看识别来源</summary><ul>
                            @foreach (var candidate in field.Candidates) { <li><strong>@candidate.Value</strong> · @candidate.Source<br />@candidate.Evidence</li> }
                            </ul></details>
                        }
                    </div>
                }
                <details class="mail-missing"><summary>补录其他字段</summary><div class="mail-fields">
                    @foreach (var field in mail.Analysis.Fields.Except(populated))
                    {
                        <div class="field mail-field"><label for="mail-field-@field.Key">@field.Label</label>
                        <input id="mail-field-@field.Key" name="fields[@field.Key]" maxlength="1500" /></div>
                    }
                </div></details>
            </div>
            <div class="mail-actions">
                <button class="button secondary" name="confirmed" value="false" type="submit">保存待办</button>
                <button class="button primary" name="confirmed" value="true" type="submit">确认复核</button>
            </div>
        </form>
        <form class="mail-body mail-reanalyze" asp-action="Reanalyze" method="post">
            <input type="hidden" name="id" value="@mail.Id" />
            <input type="hidden" name="revision" value="@mail.Revision" />
            <button class="button secondary" type="submit">重新识别</button>
        </form>
    </section>
</div>
<section class="panel mail-panel">
    <div class="panel-heading"><h2>操作记录</h2></div>
    <ul class="mail-audit">
    @foreach (var entry in Model.Audit) { <li>@Display.Time(entry.At) · @entry.Operator · @entry.Action</li> }
    </ul>
</section>
