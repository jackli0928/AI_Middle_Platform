@{ ViewData["Title"] = "暂时无法完成操作"; Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : null; }
@if (Layout is null) { <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="stylesheet" href="/css/site.css"/> }
<section class="panel error-panel"><div class="empty-state"><h1>暂时无法完成操作</h1><p>请检查数据库连接和系统配置后重试。<br/>如果正在发送消息，请先查看消息记录和企微会话，避免重复发送。</p><a class="button primary" asp-controller="Home" asp-action="Index">返回工作台</a><small class="muted">请求标识：@Context.TraceIdentifier</small></div></section>
