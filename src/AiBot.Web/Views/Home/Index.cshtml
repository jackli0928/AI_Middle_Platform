@model Dashboard
@{ ViewData["Title"] = "控制台概览"; }
<div class="page-heading"><div><div class="eyebrow">OVERVIEW</div><h1>控制台概览<span class="heading-dot">.</span></h1><p>集中管理你的机器人，让每一次消息都有迹可循。</p></div><a class="button primary" asp-controller="Robots" asp-action="Edit"><svg><use href="#i-plus"/></svg>添加机器人</a></div>
<section class="welcome-banner"><div class="banner-copy"><span class="banner-label"><span class="tiny-dot"></span> YOUR AI WORKSPACE</span><h2>让每一次连接，<br/>都更高效。</h2><p>从机器人配置到消息触达，在一个工作台完成。</p><a asp-controller="Robots" asp-action="Index">管理企微机器人<svg><use href="#i-arrow"/></svg></a></div><div class="banner-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><span class="art-node node-one"><svg><use href="#i-send"/></svg></span><span class="art-node node-two"><svg><use href="#i-check"/></svg></span><div class="art-bot"><svg><use href="#i-bot"/></svg></div><span class="art-caption">CONNECTED POSSIBILITIES</span></div></section>
<div class="stat-grid">
 <article class="stat-card"><div class="stat-top">机器人总数<span class="stat-icon mint"><svg><use href="#i-bot"/></svg></span></div><div class="stat-value">@Model.Robots<span>个</span></div><div class="stat-foot">统一管理 Bot ID 与凭据</div></article>
 <article class="stat-card"><div class="stat-top">已启用机器人<span class="stat-icon blue"><svg><use href="#i-check"/></svg></span></div><div class="stat-value">@Model.Enabled<span>个</span></div><div class="stat-foot"><span class="tiny-dot"></span>可用于发送消息</div></article>
 <article class="stat-card"><div class="stat-top">今日发送请求<span class="stat-icon violet"><svg><use href="#i-send"/></svg></span></div><div class="stat-value">@Model.TodayMessages<span>条</span></div><div class="stat-foot">北京时间 00:00 起累计</div></article>
 <article class="stat-card"><div class="stat-top">今日企微已接受<span class="stat-icon amber"><svg><use href="#i-list"/></svg></span></div><div class="stat-value">@Model.Accepted<span>条</span></div><div class="stat-foot">以企业微信发送回执为准</div></article>
</div>
<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>最近消息</h2><p>掌握每一次发送的结果</p></div><a class="text-link" asp-controller="Messages" asp-action="Index">全部记录<svg><use href="#i-arrow"/></svg></a></div><partial name="_MessageTable" model="Model.Recent"/></section><aside class="panel quickstart"><div class="panel-heading"><div><span class="eyebrow">GET STARTED</span><h2>三步，开启连接</h2></div></div><div class="step"><span>01</span><div><h3>添加企微机器人</h3><p>录入 Bot ID 与 Secret，集中管理机器人凭据。</p></div></div><div class="step"><span>02</span><div><h3>选择发送对象</h3><p>使用 User ID 发单聊，或使用 Chat ID 发群聊。</p></div></div><div class="step"><span>03</span><div><h3>查看发送回执</h3><p>确认企微是否接受请求，并追踪异常原因。</p></div></div><div class="quick-tip"><svg><use href="#i-shield"/></svg>Secret 加密存储，页面不回显。</div></aside></div>
