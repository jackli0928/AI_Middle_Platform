@model IReadOnlyList<RobotInfo>
@{ ViewData["Title"] = "企微机器人"; var search = ViewBag.Search as string; }
<div class="page-heading"><div><div class="eyebrow">WECOM BOTS</div><h1>企微机器人<span class="heading-dot">.</span></h1><p>连接你的企业微信机器人，统一配置与管理。</p></div><a class="button primary" asp-action="Edit"><svg><use href="#i-plus"/></svg>添加机器人</a></div>
<div class="collection-toolbar"><div class="collection-title">机器人列表<span class="count-pill">@Model.Count</span></div><form method="get" class="search-form"><svg><use href="#i-search"/></svg><input name="search" value="@search" placeholder="搜索名称或 Bot ID" aria-label="搜索机器人" maxlength="256"/><button type="submit">搜索</button>@if (!string.IsNullOrEmpty(search)) { <a asp-action="Index">清除</a> }</form></div>
@if (Model.Count == 0) {
 <section class="panel"><div class="empty-state large"><div class="empty-art"><svg><use href="#i-bot"/></svg></div><span class="eyebrow">BUILD YOUR BOT SPACE</span><h2>@(string.IsNullOrEmpty(search) ? "你的机器人工作台，从这里开始" : "没有找到匹配的机器人")</h2><p>@(string.IsNullOrEmpty(search) ? "添加企微机器人的 Bot ID 和 Secret，即可向企微账号或群聊发送消息。" : "试试其他名称或 Bot ID。")</p><a class="button primary" asp-action="@(string.IsNullOrEmpty(search) ? "Edit" : "Index")"><svg><use href="#i-plus"/></svg>@(string.IsNullOrEmpty(search) ? "添加第一个机器人" : "查看全部机器人")</a></div></section>
} else {
 <div class="robot-grid">@foreach (var robot in Model) {
 <article class="robot-card"><div class="robot-card-top"><span class="bot-avatar"><svg><use href="#i-bot"/></svg></span><span class="badge @(robot.Enabled ? "success" : "neutral")"><span></span>@(robot.Enabled ? "已启用" : "已停用")</span></div><h2>@robot.Name</h2><p class="robot-description">@(string.IsNullOrWhiteSpace(robot.Description) ? "暂无备注，为这个机器人添加一些说明。" : robot.Description)</p><div class="credential-row"><span>BOT ID</span><code title="@robot.BotId">@robot.BotId</code></div><div class="credential-row"><span>SECRET</span><div class="secret-masked">•••••••••••• <svg><use href="#i-shield"/></svg><small>已加密</small></div></div><div class="robot-auto-label">自动回复：@(robot.AutoReplyEnabled ? (robot.ReplyMode == "ai" ? "AI · 按模型优先级" : "知识库匹配") : "已关闭")</div><div class="robot-meta"><svg><use href="#i-clock"/></svg>更新于 @Display.Time(robot.UpdatedAt)</div><div class="robot-actions"><a class="button @(robot.Enabled ? "soft" : "secondary")" asp-action="Send" asp-route-id="@robot.Id">发送消息<svg><use href="#i-arrow"/></svg></a><a class="icon-button" asp-action="Edit" asp-route-id="@robot.Id" title="编辑 @robot.Name" aria-label="编辑 @robot.Name"><svg><use href="#i-edit"/></svg></a><form asp-action="Delete" method="post" data-delete-name="@robot.Name"><input type="hidden" name="id" value="@robot.Id"/><button class="icon-button delete-button" title="删除 @robot.Name" aria-label="删除 @robot.Name"><svg><use href="#i-trash"/></svg></button></form></div></article>
 }</div>
}
<div class="inline-note"><svg><use href="#i-info"/></svg>“已启用”表示允许发送，不代表实时在线。请在企微后台开启机器人的 API 长连接模式。</div>

