@model RobotInput
@{ ViewData["Title"] = Model.Id is null ? "添加机器人" : "编辑机器人"; }
<div class="page-heading"><div><div class="eyebrow">ROBOT CONFIGURATION</div><h1>@ViewData["Title"]<span class="heading-dot">.</span></h1><p>配置一次，让机器人随时为协作做好准备。</p></div><a class="button secondary" asp-action="Index">返回列表</a></div>
<div class="form-grid"><section class="panel form-panel"><div class="panel-heading"><div><h2>基本配置</h2><p>带 * 的项目为必填</p></div><span class="stat-icon mint"><svg><use href="#i-bot"/></svg></span></div><form asp-action="Edit" method="post" class="form-body" data-submit-lock>
 <div asp-validation-summary="All" class="validation-summary" role="alert"></div><input asp-for="Id" type="hidden"/>
 <div class="field"><label asp-for="Name">机器人名称 <b>*</b></label><input asp-for="Name" placeholder="例如：团队协作助手" maxlength="80" required/><span class="field-help">一个容易识别的名字，最多 80 个字符。</span></div>
 <div class="field"><label asp-for="BotId">Bot ID <b>*</b></label><input asp-for="BotId" class="mono" placeholder="输入企微机器人 Bot ID" maxlength="256" required autocomplete="off"/><span class="field-help">在企业微信机器人配置中获取，不是机器人名称。</span></div>
 <div class="field"><label asp-for="Secret">Secret @if (Model.Id is null) { <b>*</b> } else { <span class="optional">选填</span> }</label><div class="password-input"><input asp-for="Secret" type="password" value="" autocomplete="new-password" maxlength="512" placeholder="@(Model.Id is null ? "输入机器人 Secret" : "留空则保留原有 Secret")" required="@(Model.Id is null)"/><button type="button" class="icon-button toggle-password" aria-label="显示 Secret"><svg><use href="#i-eye"/></svg></button></div><span class="field-help">凭据加密保存，保存后不会在页面回显。</span></div>
 <div class="field"><label asp-for="Description">备注 <span class="optional">选填</span></label><textarea asp-for="Description" rows="3" maxlength="500" placeholder="说明机器人的用途，方便后续管理"></textarea></div>
 <label class="switch-row"><span><strong>启用机器人</strong><small>开启后，允许使用此机器人发送消息</small></span><span class="switch"><input asp-for="Enabled"/><span></span></span></label>
 <partial name="_AutoReplySettings" model="Model"/>
 <div class="form-actions"><a class="button secondary" asp-action="Index">取消</a><button class="button primary" type="submit"><svg><use href="#i-check"/></svg>保存配置</button></div>
</form></section><aside class="form-aside"><div class="guide-icon"><svg><use href="#i-key"/></svg></div><h2>连接你的企微机器人</h2><p>在企业微信中创建智能机器人，并开启 API 长连接模式。</p><ol class="guide-list"><li><span>1</span><div>打开机器人配置页面<small>找到智能机器人的 API 模式配置。</small></div></li><li><span>2</span><div>复制 Bot ID 和 Secret<small>请妥善保管，不要分享给无关人员。</small></div></li><li><span>3</span><div>保存并发送一条消息<small>使用实际企微 User ID 验证消息触达。</small></div></li></ol><div class="aside-tip"><svg><use href="#i-shield"/></svg><p>更换 Secret 后，请同步更新这里的配置。编辑时留空会继续使用原有凭据。</p></div></aside></div>
