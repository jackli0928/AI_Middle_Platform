@model SendViewModel
@{ ViewData["Title"] = "发送消息"; var enabled = Model.Robots.Where(x => x.Enabled).ToList(); }
<div class="page-heading"><div><div class="eyebrow">MESSAGE COMPOSER</div><h1>发送消息<span class="heading-dot">.</span></h1><p>从这里出发，把消息送到需要的人手中。</p></div><a class="button secondary" asp-controller="Messages" asp-action="Index"><svg><use href="#i-list"/></svg>消息记录</a></div>
<div class="send-grid"><section class="panel form-panel"><div class="panel-heading"><div><h2>新建消息</h2><p>通过机器人向企微账号或群聊发送 Markdown 消息</p></div><span class="badge success"><span></span><b id="target-mode-badge">@(Model.Input.TargetType == "group" ? "群聊发送" : "单聊发送")</b></span></div><form asp-action="Send" method="post" class="form-body" id="send-form" data-submit-lock><div asp-validation-summary="All" class="validation-summary" role="alert"></div><input asp-for="Input.OperationId" type="hidden"/>
 <div class="field"><label asp-for="Input.RobotId">发送机器人 <b>*</b></label><select asp-for="Input.RobotId" required><option value="">选择一个已启用的机器人</option>@foreach (var robot in enabled) { <option value="@robot.Id">@robot.Name</option> }</select>@if (enabled.Count == 0) { <span class="field-help">暂无已启用的机器人。<a asp-action="Edit">添加机器人</a> 或在列表中编辑启用。</span> }</div>
 <div class="field"><label asp-for="Input.TargetType">发送对象 <b>*</b></label><select asp-for="Input.TargetType"><option value="single">单聊 · User ID</option><option value="group">群聊 · Chat ID</option></select></div>
 <div class="field" id="user-target-field" hidden="@(Model.Input.TargetType == "group")"><label asp-for="Input.UserId">接收人 User ID <b>*</b></label><input asp-for="Input.UserId" placeholder="例如：zhangsan" maxlength="256" required="@(Model.Input.TargetType != "group")" disabled="@(Model.Input.TargetType == "group")" autocomplete="off"/><span class="field-help">填写企业微信通讯录中的实际 userid，每次仅支持一个账号。</span></div>
 <div class="field" id="group-target-field" hidden="@(Model.Input.TargetType != "group")"><label asp-for="Input.ChatId">群聊 Chat ID <b>*</b></label><input asp-for="Input.ChatId" placeholder="填写目标群聊的 chatid" maxlength="256" required="@(Model.Input.TargetType == "group")" disabled="@(Model.Input.TargetType != "group")" autocomplete="off"/><span class="field-help">使用该机器人收到的群聊消息回调中的 body.chatid，不能填写群名称；确认机器人已加入目标群。</span></div>
 <div class="field"><div class="label-row"><label for="message-content">消息内容 <b>*</b></label><span class="format-label">MARKDOWN</span></div><textarea asp-for="Input.Content" rows="10" placeholder="输入你想发送的消息…" required id="message-content"></textarea><div class="field-bottom"><span>支持 Markdown 语法，右侧显示原文预览</span><span id="byte-count" class="mono" aria-live="polite">0 / 4096 字节</span></div></div>
 <div class="send-hint"><svg><use href="#i-info"/></svg><p>发送后可查看企微回执。若结果未确认，请先查看企微会话，避免重复发送。</p></div><div class="form-actions"><span class="secure-caption"><svg><use href="#i-shield"/></svg>凭据由服务端安全读取</span><button class="button primary" type="submit" id="send-button" disabled="@(enabled.Count == 0)"><svg><use href="#i-send"/></svg>发送消息</button></div>
</form></section><aside class="preview-column"><div class="preview-header"><span>消息原文预览</span><span class="preview-live"><span></span>实时</span></div><div class="phone-preview"><div class="chat-header"><span class="mini-wecom">企</span><div id="preview-bot">企微机器人<small>机器人消息</small></div><span class="chat-dots">···</span></div><div class="chat-body"><div class="chat-date">发送效果以企业微信客户端为准</div><div class="chat-message"><span class="bot-avatar small"><svg><use href="#i-bot"/></svg></span><div class="chat-bubble"><span class="preview-placeholder" id="preview-placeholder">你的消息将在这里显示。<br/>写下内容，开启一次连接。</span><pre id="message-preview" hidden></pre></div></div></div><div class="chat-footer"><span></span><span>+</span></div></div><div class="preview-note"><h3>发送前的小提示</h3><p id="target-help">@(Model.Input.TargetType == "group" ? "请确认机器人已加入目标群，使用群聊消息回调中的实际 chatid。每次仅支持一个群聊。" : "接收人应在机器人可见范围内，并已打开对应机器人会话。User ID 不是姓名、昵称或微信号。")</p></div></aside></div>
