@model RobotInput
@{ var models = ViewBag.AiModels as IReadOnlyList<AiModelInfo> ?? []; var ids = Model.ModelPriority.Count == 0 ? new List<Guid> { Guid.Empty } : Model.ModelPriority; }
<section class="robot-automation"><label class="switch-row"><span><strong>收到消息后自动回复</strong><small>默认关闭；开启后对新收到的适用消息回复一次</small></span><span class="switch"><input asp-for="AutoReplyEnabled"/><span></span></span></label>
<div id="auto-reply-options" hidden="@(!Model.AutoReplyEnabled)"><div class="field"><label asp-for="ReplyMode">回复机制</label><select asp-for="ReplyMode"><option value="knowledge">1 · 匹配知识库回复</option><option value="ai">2 · AI 回复</option><option value="quote">3 · AI 报价</option></select></div>
<div id="quote-reply-help" class="automation-help" hidden="@(Model.ReplyMode != "quote")">可直接选择报价 MCP，无需配置 AI 模型。请按「目的地 LAX，10件，200kg，2方」提供完整询价；自由表述可选配 AI 模型提取字段。当前版本处理单聊文字询价。</div>
<div id="knowledge-reply-help" class="automation-help" hidden="@(Model.ReplyMode != "knowledge")">匹配已启用的共享或机器人专属知识条目，未匹配时不回复。<a asp-controller="Knowledge" asp-action="Index">管理知识库 →</a></div>
<div id="ai-reply-options" hidden="@(Model.ReplyMode != "ai" && Model.ReplyMode != "quote")"><div class="label-row"><label id="model-choice-label">@(Model.ReplyMode == "quote" ? "询价解析方式" : "AI 模型优先级")</label><a class="text-link" asp-controller="AiModels" asp-action="Index">管理模型接口</a></div><p class="field-help">报价 MCP 使用明确格式提取字段；选择 AI 模型可处理更自由的询价表述。普通 AI 回复必须选择模型。</p>
<div id="model-priority-list">@foreach (var id in ids) { <div class="model-priority-row"><span class="priority-number"></span><select name="ModelPriority" aria-label="优先模型"><option value="@Guid.Empty">@(Model.ReplyMode == "quote" ? "报价 MCP（无需模型）" : "选择模型接口")</option>@foreach (var endpoint in models) { <option value="@endpoint.Id" selected="@(endpoint.Id == id)">@endpoint.Name · @endpoint.Provider@(endpoint.Enabled ? "" : "（已停用）")</option> }</select><button type="button" class="icon-button" data-priority-up aria-label="提高模型优先级">↑</button><button type="button" class="icon-button" data-priority-down aria-label="降低模型优先级">↓</button><button type="button" class="icon-button" data-priority-remove aria-label="移除此模型">×</button></div> }</div>
<template id="model-priority-template"><div class="model-priority-row"><span class="priority-number"></span><select name="ModelPriority" aria-label="优先模型"><option value="@Guid.Empty">选择模型接口</option>@foreach (var endpoint in models) { <option value="@endpoint.Id">@endpoint.Name · @endpoint.Provider@(endpoint.Enabled ? "" : "（已停用）")</option> }</select><button type="button" class="icon-button" data-priority-up aria-label="提高模型优先级">↑</button><button type="button" class="icon-button" data-priority-down aria-label="降低模型优先级">↓</button><button type="button" class="icon-button" data-priority-remove aria-label="移除此模型">×</button></div></template>
<button class="button secondary compact" id="add-priority-model" type="button"><svg><use href="#i-plus"/></svg>增加备用模型</button>@if (models.Count == 0) { <p class="field-help">暂无模型接口。AI 报价可直接选择报价 MCP；普通 AI 回复需要先添加模型接口。</p> }
<div class="field auto-prompt"><label asp-for="ReplyPrompt">AI 回复要求 <span class="optional">选填</span></label><textarea asp-for="ReplyPrompt" maxlength="2000" rows="4" placeholder="例如：你是团队工作助手，请简洁、准确地回答用户问题。"></textarea></div></div>
<label id="group-reply-setting" class="automation-checkbox" hidden="@(Model.ReplyMode == "quote")"><input asp-for="ReplyToGroups"/>同时自动回复群聊中发给／@@机器人的消息</label><p class="field-help">单聊始终适用；忽略机器人自身消息、无文字的媒体消息和重复回调。变更仅影响新收到的消息，不补发旧消息。</p></div></section>
