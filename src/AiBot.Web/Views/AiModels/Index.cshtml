@model IReadOnlyList<AiModelInfo>
@{ ViewData["Title"] = "AI 模型接口"; }
<div class="page-heading"><div><div class="eyebrow">AI MODEL CONNECTIONS</div><h1>AI 模型接口<span class="heading-dot">.</span></h1><p>统一配置模型服务，再为每个机器人安排调用优先级。</p></div><a class="button primary" asp-action="Edit"><svg><use href="#i-plus"/></svg>新增模型接口</a></div>
<section class="panel"><div class="panel-heading"><div><h2>模型连接</h2><p>API Key 加密保存；保存配置不会调用模型</p></div><span class="count-pill">@Model.Count</span></div>@if (Model.Count == 0) { <div class="empty-state large"><div class="empty-art"><svg><use href="#i-bot"/></svg></div><h2>接入你的 AI 模型</h2><p>支持 OpenAI Responses 和兼容 Chat Completions 的接口。<br/>填写实际 API 地址、模型 ID 与密钥后即可启用。</p><a class="button primary" asp-action="Edit">配置第一个模型</a></div> } else { <div class="table-scroll"><table><thead><tr><th>模型 / 提供方</th><th>模型 ID / 接口</th><th>格式</th><th>密钥</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach (var endpoint in Model) { <tr><td><strong>@endpoint.Name</strong><small class="settings-subtext">@endpoint.Provider</small></td><td class="endpoint-cell"><code>@endpoint.ModelId</code><small class="settings-subtext" title="@endpoint.Endpoint">@endpoint.Endpoint</small></td><td>@(endpoint.ApiStyle == "responses" ? "Responses" : "Chat Completions")</td><td><span class="badge @(endpoint.HasApiKey ? "success" : "warning")">@(endpoint.HasApiKey ? "已加密配置" : "待填写")</span></td><td><span class="badge @(endpoint.Enabled ? "success" : "neutral")">@(endpoint.Enabled ? "已启用" : "已停用")</span></td><td><div class="table-actions"><a class="text-link" asp-action="Edit" asp-route-id="@endpoint.Id">编辑</a><form asp-action="Delete" method="post" data-delete-name="@endpoint.Name" data-delete-kind="模型接口" data-delete-note="删除接口配置，历史回复记录仍会保留；被机器人引用的接口需先解除引用。"><input name="id" value="@endpoint.Id" type="hidden"/><button class="icon-button delete-button" title="删除模型接口" aria-label="删除 @endpoint.Name"><svg><use href="#i-trash"/></svg></button></form></div></td></tr> }</tbody></table></div> }</section>
<div class="inline-note"><svg><use href="#i-info"/></svg>模型展示名可自行命名；模型 ID 必须与所用接口一致。各模型的优先级在机器人配置中设置。</div>
